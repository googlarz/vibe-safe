#!/bin/sh
# vibe-safe pre-commit hook
# Mechanical safety checks on every commit — no Claude required.
# Install: cp ~/.claude/skills/vibe-safe/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

# Word-anchored, hyphen-aware, colon+equals, special-char-aware — catches object literals and real passwords
# [:=] catches both assignment (password = 'x') and object property (password: 'x')
# !@# in value class catches real passwords like Demo@123! that pure alphanum misses
CRED_PATTERN='\bsk-[A-Za-z0-9_-]{8,}|\bpk_(live|test)_[A-Za-z0-9]{8,}|\bgh[opushr]_[A-Za-z0-9]{16,}|\bgithub_pat_[A-Za-z0-9_]{20,}|\b(AKIA|ASIA)[A-Z0-9]{16}\b|\bhf_[A-Za-z0-9]{16,}|\bnpm_[A-Za-z0-9]{20,}|\bxox[abprs]-[A-Za-z0-9-]{20,}|\bSG\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{20,}|\bwhsec_[A-Za-z0-9]{20,}|\b(api_key|secret|password|token)\s*[:=]\s*['"'"'"][A-Za-z0-9_/+\-!@#]{4,}['"'"'"]|Bearer [A-Za-z0-9._/+\-]{20,}|AccountKey=[A-Za-z0-9+/]{40,}={0,2}|"private_key_id"\s*:\s*"[a-f0-9]{40}"'

bail() {
  echo ""
  echo "vibe-safe: $1"
  echo "$2"
  echo ""
  echo "$3"
  echo ""
  exit 1
}

# 1. Branch check
BRANCH=$(git branch --show-current 2>/dev/null)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  bail "STOP -- committing directly to $BRANCH." "" \
    "Create a branch: git checkout -b feature/your-change-name"
fi

# 2. Credential scan across ALL tracked files (not just staged)
# Exclude test dirs, example/sample files — they legitimately contain dummy credentials
CREDS=$(git grep -nP "$CRED_PATTERN" -- ':(exclude,glob)**/tests/**' ':(exclude,glob)**/test/**' ':(exclude,glob)**/spec/**' ':(exclude,glob)**/*.example' ':(exclude,glob)**/*.sample' ':(exclude,glob)**/*.test.*' ':(exclude,glob)**/*.spec.*' 2>/dev/null)
if [ -n "$CREDS" ]; then
  bail "STOP -- credential pattern found in tracked files:" "$CREDS" \
    "Credentials in git history are permanent even after deletion. Run: vibe-safe commit"
fi

# Capture staged diff once for all diff-based checks
STAGED_DIFF=$(git diff --cached 2>/dev/null)
ADDED=$(echo "$STAGED_DIFF" | grep "^+" | grep -v "^+++" 2>/dev/null)
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null)

# Workflow files referenced by checks 54, 55, 64 — define once
WF_FILES=$(echo "$STAGED_FILES" | grep -E "\.github/workflows/.*\.ya?ml$" 2>/dev/null)

# 64. Unpinned GitHub Actions — emit warning before danger-zone bail so it's always visible
for wf in $WF_FILES; do
  WF_ADDED=$(git diff --cached -- "$wf" 2>/dev/null | grep "^+" | grep -v "^+++")
  UNPINNED=$(echo "$WF_ADDED" | grep -E "uses:\s+[A-Za-z0-9_/-]+@(v[0-9]|main|master|latest|HEAD)" 2>/dev/null)
  if [ -n "$UNPINNED" ]; then
    echo ""
    echo "vibe-safe: GitHub Action not pinned to SHA in $wf -- tag can be overwritten by maintainer"
    echo "$UNPINNED"
    echo "  Pin to a full commit SHA: uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683"
    echo ""
  fi
done

# 3. Danger zone check on staged files
DANGER=""
for f in $STAGED_FILES; do
  case "$f" in
    .env|.env.local|.env.production|.env.staging|.env.development|*.conf|Dockerfile|docker-compose*|\
    .github/workflows/*|Jenkinsfile|.circleci/*|.gitlab-ci.yml|\
    */migrations/*|*/schema/*|*.sql|\
    webpack.config.*|vite.config.*|tsconfig.json|\
    jest.config.*|vitest.config.*|codecov.yml|.nycrc|sonar-project.properties|\
    pytest.ini|setup.cfg|pyproject.toml|.coveragerc|\
    package.json|Gemfile|requirements.txt)
      DANGER="${DANGER:+$DANGER
}  $f (infrastructure/config/quality-gate)"
      ;;
  esac

  BASENAME=$(basename "$f" | tr '[:upper:]' '[:lower:]')
  case "$BASENAME" in
    *auth*|*login*|*session*|*jwt*|*oauth*|*permission*|*role*)
      DANGER="${DANGER:+$DANGER
}  $f (auth/security)"
      ;;
    .eslintrc*|.stylelintrc*)
      DANGER="${DANGER:+$DANGER
}  $f (quality-gate)"
      ;;
  esac

  # .vibesafe custom danger zones
  if [ -f ".vibesafe" ]; then
    while IFS= read -r line; do
      case "$line" in
        danger_zone:*)
          ZONE=$(echo "$line" | sed 's/^danger_zone:[[:space:]]*//')
          case "$f" in
            ${ZONE}*) DANGER="${DANGER:+$DANGER
}  $f (custom zone: $ZONE)" ;;
          esac
          ;;
      esac
    done < .vibesafe
  fi
done

if [ -n "$DANGER" ]; then
  bail "PAUSE -- Danger Zone files staged:" "$DANGER" \
    "These need developer review. Run: vibe-safe commit"
fi

# 4. Error suppression check
SUPPRESS=$(echo "$ADDED" | grep -E "@ts-ignore|@ts-nocheck|@ts-expect-error|eslint-disable" 2>/dev/null)
if [ -n "$SUPPRESS" ]; then
  bail "PAUSE -- Error suppression added:" "$SUPPRESS" \
    "Claude may have hidden errors instead of fixing them. Run: vibe-safe commit"
fi

# 5. Test bypass check
SKIPPED=$(echo "$ADDED" | grep -E "\.skip\(|[^a-z]xit\(|[^a-z]xdescribe\(|[^a-z]xtest\(" 2>/dev/null)
if [ -n "$SKIPPED" ]; then
  bail "PAUSE -- Tests bypassed:" "$SKIPPED" \
    "Claude may have skipped failing tests instead of fixing them. Run: vibe-safe commit"
fi

# 6. Debug artifact check (excluding test files)
DEBUG_FILES=$(echo "$STAGED_FILES" | grep -v -E "\.(test|spec)\." 2>/dev/null)
if [ -n "$DEBUG_FILES" ]; then
  DEBUG=$(echo "$ADDED" | grep -E "console\.(log|error|warn|debug)|debugger;" 2>/dev/null)
  if [ -n "$DEBUG" ]; then
    bail "PAUSE -- Debug output in non-test files:" "$DEBUG" \
      "Remove before committing or run: vibe-safe commit"
  fi
fi

# 7. Empty catch check
EMPTY_CATCH=$(echo "$ADDED" | grep -E "catch\s*\(\w*\)\s*\{[[:space:]]*\}|catch\s*\{[[:space:]]*\}" 2>/dev/null)
if [ -n "$EMPTY_CATCH" ]; then
  bail "PAUSE -- Empty catch block added:" "$EMPTY_CATCH" \
    "Errors silently swallowed. Run: vibe-safe commit"
fi

# 8. Lock file drift check
LOCK_CHANGED=$(echo "$STAGED_FILES" | grep -E "package-lock\.json|yarn\.lock|pnpm-lock\.yaml" 2>/dev/null)
PKG_CHANGED=$(echo "$STAGED_FILES" | grep "^package\.json$" 2>/dev/null)
if [ -n "$LOCK_CHANGED" ] && [ -z "$PKG_CHANGED" ]; then
  bail "PAUSE -- Lock file changed without package.json:" "$LOCK_CHANGED" \
    "Manual lock file edits are almost always wrong. Run: vibe-safe commit"
fi

# 9. Binary file check
BINARY=$(git diff --cached --numstat 2>/dev/null | awk '$1 == "-" && $2 == "-" {print "  " $3 " (binary)"}')
if [ -n "$BINARY" ]; then
  bail "PAUSE -- Binary files staged:" "$BINARY" \
    "Binary files bloat git history permanently. Run: vibe-safe commit"
fi

# 10. XSS sink check
XSS=$(echo "$ADDED" | grep -E "dangerouslySetInnerHTML|innerHTML\s*=|document\.write\(" 2>/dev/null)
if [ -n "$XSS" ]; then
  bail "PAUSE -- XSS sink added:" "$XSS" \
    "Any user input reaching this is a vulnerability. Run: vibe-safe commit"
fi

# 11. Code injection check
EVAL=$(echo "$ADDED" | grep -E "\beval\(" 2>/dev/null)
if [ -n "$EVAL" ]; then
  bail "PAUSE -- eval() added:" "$EVAL" \
    "Arbitrary code execution risk. Run: vibe-safe commit"
fi

# 12. SSL bypass check
SSL=$(echo "$ADDED" | grep -E "verify=False|NODE_TLS_REJECT_UNAUTHORIZED|rejectUnauthorized:\s*false|ssl_verify:\s*false" 2>/dev/null)
if [ -n "$SSL" ]; then
  bail "STOP -- SSL verification disabled:" "$SSL" \
    "Claude may have silenced a cert error by removing all TLS protection. Run: vibe-safe commit"
fi

# 13. CORS wildcard check
CORS=$(echo "$ADDED" | grep -E "origin:\s*['\"]?\*['\"]?|Access-Control-Allow-Origin:\s*\*" 2>/dev/null)
if [ -n "$CORS" ]; then
  bail "PAUSE -- CORS wildcard added:" "$CORS" \
    "API now accepts requests from any domain. Run: vibe-safe commit"
fi

# 14. .gitignore regression check
if echo "$STAGED_FILES" | grep -q "^\.gitignore$"; then
  REMOVED=$(echo "$STAGED_DIFF" | grep "^\-.gitignore" | grep -v "^---" 2>/dev/null)
  if [ -n "$REMOVED" ]; then
    bail "PAUSE -- .gitignore entries removed:" "$REMOVED" \
      "Previously ignored files are now tracked and may be committed. Run: vibe-safe commit"
  fi
fi

# 15. Timing hack check
TIMING=$(echo "$ADDED" | grep -E "setTimeout\s*\([^,]+,\s*[0-9]+|sleep\s*\([0-9]|time\.sleep\s*\([0-9]|asyncio\.sleep\s*\([0-9]" 2>/dev/null)
if [ -n "$TIMING" ]; then
  bail "PAUSE -- Hardcoded timing delay added:" "$TIMING" \
    "Claude may have papered over a race condition. Run: vibe-safe commit"
fi

# 16. Debug mode check (non-test files only)
NON_TEST_FILES=$(echo "$STAGED_FILES" | grep -v -E "\.(test|spec)\.|__tests__" 2>/dev/null)
if [ -n "$NON_TEST_FILES" ]; then
  DEBUG_MODE=$(echo "$ADDED" | grep -E "DEBUG\s*=\s*True|debug:\s*true|APP_ENV\s*=\s*['\"]?development" 2>/dev/null)
  if [ -n "$DEBUG_MODE" ]; then
    bail "PAUSE -- Debug mode in non-test file:" "$DEBUG_MODE" \
      "Check this isn't heading to production. Run: vibe-safe commit"
  fi
fi

# 17. TODO/FIXME stub check (implementation files only, not .md or test files)
IMPL_FILES=$(echo "$STAGED_FILES" | grep -v -E "\.(md|txt)$|\.(test|spec)\.|__tests__" 2>/dev/null)
if [ -n "$IMPL_FILES" ]; then
  TODO_STUB=$(echo "$ADDED" | grep -iE "(throw|raise).*(todo|not.?implemented|NotImplementedError)|//\s*TODO[^:]*:|#\s*FIXME[^:]*:" 2>/dev/null)
  if [ -n "$TODO_STUB" ]; then
    bail "PAUSE -- TODO/FIXME stub in implementation code:" "$TODO_STUB" \
      "Claude left a placeholder instead of implementing. This will fail at runtime."
  fi
fi

# 18. Commented-out code check
COMMENTED=$(echo "$ADDED" | grep -E "^\+\s*(//|#)\s*(const |let |var |function |return |import |export |if |for |while |class |def |async )" 2>/dev/null)
if [ -n "$COMMENTED" ]; then
  bail "PAUSE -- Commented-out code added:" "$COMMENTED" \
    "Claude may have been unsure — disabled code should not ship. Run: vibe-safe commit"
fi

# 19. Private key file check
KEY_EXT=$(echo "$STAGED_FILES" | grep -iE "\.(pem|key|pfx|p12|jks|crt|cer)$|^(id_rsa|id_ed25519|id_dsa|id_ecdsa)$" 2>/dev/null)
if [ -n "$KEY_EXT" ]; then
  bail "STOP -- Private key or certificate file staged:" "$KEY_EXT" \
    "Binary credentials are not caught by text grep. Keys in git history are permanently compromised."
fi

# 20. Destructive rm -rf in scripts
SCRIPT_FILES=$(echo "$STAGED_FILES" | grep -E "\.(sh|bash|zsh|fish|mk|Makefile)$|Makefile|\.github/workflows/" 2>/dev/null)
if [ -n "$SCRIPT_FILES" ]; then
  RMRF=$(echo "$ADDED" | grep -E "rm\s+-rf?\s+" 2>/dev/null)
  if [ -n "$RMRF" ]; then
    bail "PAUSE -- rm -rf in committed script:" "$RMRF" \
      "Verify this path is never a production directory before committing."
  fi
fi

# 21. String throw (no Error object) in JS/TS
JS_FILES=$(echo "$STAGED_FILES" | grep -E "\.(js|ts|jsx|tsx|mjs|cjs)$" 2>/dev/null)
if [ -n "$JS_FILES" ]; then
  STRING_THROW=$(echo "$ADDED" | grep -E "throw\s+['\"]" 2>/dev/null)
  if [ -n "$STRING_THROW" ]; then
    bail "PAUSE -- String thrown instead of Error object:" "$STRING_THROW" \
      "Stack trace is lost. Production bugs become undiagnosable. Use: throw new Error(\"message\")"
  fi
fi

# 22. .env.example drift
ENV_REFS=$(echo "$ADDED" | grep -E "process\.env\.|os\.environ\[|getenv\(|import\.meta\.env\." 2>/dev/null)
if [ -n "$ENV_REFS" ]; then
  ENV_EXAMPLE_CHANGED=$(echo "$STAGED_FILES" | grep -E "^\.env\.example$|^\.env\.sample$" 2>/dev/null)
  if [ -z "$ENV_EXAMPLE_CHANGED" ]; then
    bail "PAUSE -- New env variable referenced without .env.example update:" "$ENV_REFS" \
      "Other developers won't know to set this variable. Add it to .env.example first."
  fi
fi

# 23. Migration rollback check
MIGRATION_FILES=$(echo "$STAGED_FILES" | grep -E "migrations/|db/migrate/|_migration\." 2>/dev/null)
REQ_ROLLBACK=$([ -f ".vibesafe" ] && grep "^require_migration_rollback:[[:space:]]*true" .vibesafe 2>/dev/null || true)
if [ -n "$MIGRATION_FILES" ]; then
  for mf in $MIGRATION_FILES; do
    # Skip Django auto-reversible migrations
    if grep -q "from django.db import migrations" "$mf" 2>/dev/null; then
      continue
    fi
    if ! grep -qiE "def down|def downgrade|exports\.down|\.down\(|rollback\(|-- Down" "$mf" 2>/dev/null; then
      if [ -n "$REQ_ROLLBACK" ]; then
        bail "STOP -- Developer contract: migration without rollback: $mf" "" \
          "Your team requires all migrations to include a down/downgrade/rollback. Add one before committing."
      else
        bail "PAUSE -- Migration without rollback: $mf" "" \
          "This schema change cannot be undone automatically. Add a down() or rollback function. Run: vibe-safe commit"
      fi
    fi
  done
fi

# 24. Developer contracts from .vibesafe
if [ -f ".vibesafe" ]; then
  # max_changed_files (soft ceiling — warns and routes to SCOPE, does not hard block)
  MAX=$(grep "^max_changed_files:" .vibesafe 2>/dev/null | sed 's/.*:[[:space:]]*//' | head -1)
  if [ -n "$MAX" ]; then
    FILE_COUNT=0
    if [ -n "$STAGED_FILES" ]; then
      FILE_COUNT=$(echo "$STAGED_FILES" | wc -l | tr -d ' ')
    fi
    if [ "$FILE_COUNT" -gt "$MAX" ]; then
      echo ""
      echo "vibe-safe: SCOPE WARNING -- $FILE_COUNT files staged, developer contract max is $MAX"
      echo "  Run: vibe-safe scope"
      echo "  Unexpected files may have been changed by Claude. Review before committing."
      echo ""
    fi
  fi
  # block_pattern — check per implementation file (skips test/md files)
  while IFS= read -r line; do
    case "$line" in
      block_pattern:*)
        PAT=$(echo "$line" | sed 's/^block_pattern:[[:space:]]*//')
        BLOCKED=""
        for sf in $STAGED_FILES; do
          case "$sf" in
            *.test.*|*.spec.*|*__tests__*|*_test.*|*.md|*.txt|.vibesafe) continue ;;
          esac
          FILE_ADDED=$(git diff --cached -- "$sf" 2>/dev/null | grep "^+" | grep -v "^+++" 2>/dev/null)
          MATCH=$(echo "$FILE_ADDED" | grep -F "$PAT" 2>/dev/null)
          if [ -n "$MATCH" ]; then
            BLOCKED="${BLOCKED:+$BLOCKED
}$sf: $MATCH"
          fi
        done
        if [ -n "$BLOCKED" ]; then
          bail "STOP -- Developer contract: blocked pattern '$PAT' found in added code" "$BLOCKED" \
            "Your team has blocked this pattern. Remove it before committing."
        fi
        ;;
    esac
  done < .vibesafe
  # require_tests (enforced only when source files are staged)
  REQ_TESTS=$(grep "^require_tests:[[:space:]]*true" .vibesafe 2>/dev/null)
  if [ -n "$REQ_TESTS" ]; then
    SRC_FILES=$(echo "$STAGED_FILES" | grep -E "\.(js|ts|jsx|tsx|py|rb|go|rs|java|cs)$" | grep -v -E "\.(test|spec)\.|_test\." 2>/dev/null)
    TEST_FILES=$(echo "$STAGED_FILES" | grep -E "\.(test|spec)\.|_test\.|/tests/|/__tests__/" 2>/dev/null)
    if [ -n "$SRC_FILES" ] && [ -z "$TEST_FILES" ]; then
      bail "STOP -- Developer contract: require_tests=true, no test files staged" "$SRC_FILES" \
        "Your team requires test changes alongside source changes. Add or update tests. Run: vibe-safe commit"
    fi
  fi
fi

# 25. Missing await on async calls (common Claude bug)
JS_CHANGES=$(echo "$STAGED_FILES" | grep -E "\.(js|ts|jsx|tsx|mjs|cjs)$" 2>/dev/null)
if [ -n "$JS_CHANGES" ]; then
  MISSING_AWAIT=""
  for sf in $STAGED_FILES; do
    case "$sf" in *.js|*.ts|*.jsx|*.tsx|*.mjs|*.cjs) ;;
      *) continue ;;
    esac
    FILE_ADDED=$(git diff --cached -- "$sf" 2>/dev/null | grep "^+" | grep -v "^+++")
    MATCH=$(echo "$FILE_ADDED" | grep -E "=[[:space:]]*(fetch|axios\.(get|post|put|delete|patch)|prisma\.[a-zA-Z]+\.(find|create|update|delete|upsert|count|findFirst|findMany|aggregate)|db\.(query|execute|run|all|get))\(" 2>/dev/null | grep -v "await")
    [ -n "$MATCH" ] && MISSING_AWAIT="${MISSING_AWAIT:+$MISSING_AWAIT
}$sf: $MATCH"
  done
  [ -n "$MISSING_AWAIT" ] && echo "vibe-safe: possible missing await on async call — result may be a Promise, not a value
$MISSING_AWAIT"
fi

# 26. Math.random() in security-sensitive file
SEC_RAND=$(git diff --cached -- '*.js' '*.ts' '*.jsx' '*.tsx' 2>/dev/null | grep "^+" | grep -v "^+++" | grep -E "Math\.random\(\)" 2>/dev/null)
if [ -n "$SEC_RAND" ]; then
  SEC_FILES=$(echo "$STAGED_FILES" | grep -iE "auth|token|session|crypto|key|secret|password" 2>/dev/null)
  if [ -n "$SEC_FILES" ]; then
    bail "STOP — Math.random() in security-related file: use crypto.randomBytes() or crypto.randomUUID()
$SEC_RAND" "" ""
  fi
fi

# 27. SQL string concatenation (injection risk)
SQLI=$(git diff --cached 2>/dev/null | grep "^+" | grep -v "^+++" | grep -v -E "^(\+[[:space:]]*)?(#|//|\*)" | grep -E "['\"]([[:space:]]*(SELECT|INSERT|UPDATE|DELETE|WHERE))[^'\"]*['\"][[:space:]]*\+|f['\x27](SELECT|INSERT|UPDATE|DELETE).*\{" 2>/dev/null)
[ -n "$SQLI" ] && bail "STOP — SQL string concatenation: use parameterized queries, string-built SQL is injectable
$SQLI" "" ""

# 28. Shell injection risk
SHELL_INJ=$(git diff --cached 2>/dev/null | grep "^+" | grep -v "^+++" | grep -E "shell:[[:space:]]*true|shell=True|subprocess.*shell=True" 2>/dev/null)
[ -n "$SHELL_INJ" ] && bail "STOP — shell:true passes command through /bin/sh — unsanitized input becomes code execution
$SHELL_INJ" "" ""

# 29. Test file with no assertions
TEST_STAGED=$(echo "$STAGED_FILES" | grep -E "\.(test|spec)\.(js|ts|jsx|tsx)$|_test\.(js|ts|py|go|rb)$" 2>/dev/null)
if [ -n "$TEST_STAGED" ]; then
  for tf in $TEST_STAGED; do
    FILE_ADDED=$(git diff --cached -- "$tf" 2>/dev/null | grep "^+" | grep -v "^+++")
    HAS_TEST=$(echo "$FILE_ADDED" | grep -E "it\(|test\(|describe\(" 2>/dev/null)
    HAS_ASSERT=$(echo "$FILE_ADDED" | grep -E "expect\(|assert\.|\.toBe|\.toEqual|\.toHaveBeenCalled|\.toThrow|\.toMatch" 2>/dev/null)
    [ -n "$HAS_TEST" ] && [ -z "$HAS_ASSERT" ] && echo "vibe-safe: test added without assertions in $tf — test always passes regardless of behavior"
  done
fi

# 30. Coverage threshold drop (--cov-fail-under lowered)
COV_DROP=$(echo "$STAGED_DIFF" | grep "^-" | grep -v "^---" | grep -E "\-\-cov-fail-under[= ][0-9]|cov_fail_under[[:space:]]*=[[:space:]]*[0-9]|fail_under[[:space:]]*=[[:space:]]*[0-9]" 2>/dev/null)
[ -n "$COV_DROP" ] && echo "vibe-safe: coverage threshold lowered -- verify this wasn't done to make CI pass
$COV_DROP"

# 31. API key committed in client-side / frontend file (visible in browser)
FRONTEND_CRED=""
for f in $STAGED_FILES; do
  case "$f" in
    src/*|frontend/*|public/*|static/*|client/*|components/*|pages/*|app/*)
      FILE_ADDED=$(git diff --cached -- "$f" 2>/dev/null | grep "^+" | grep -v "^+++")
      MATCH=$(echo "$FILE_ADDED" | grep -E "sk-[a-zA-Z0-9_-]{8,}|pk_(live|test)_[a-zA-Z0-9]{8,}|AKIA[A-Z0-9]{16}|api[_-]?key[[:space:]]*[:=][[:space:]]*['\"][a-zA-Z0-9_\-]{8,}" 2>/dev/null)
      [ -n "$MATCH" ] && FRONTEND_CRED="${FRONTEND_CRED:+$FRONTEND_CRED
}$f: $MATCH"
      ;;
  esac
done
[ -n "$FRONTEND_CRED" ] && bail "STOP -- credential in client-side file: visible to anyone who opens DevTools" "$FRONTEND_CRED" \
  "Move to a server-side environment variable or route the call through a backend proxy."

# 32. Sensitive data in log statements
SECRET_LOG=$(echo "$ADDED" | grep -E "console\.(log|error|warn|info)\(|logger\.(info|debug|error|warn)\(|print\(|logging\.(info|debug|error|warning)\(" 2>/dev/null | grep -iE "password|secret|token|api.?key|private.?key|credential|auth" 2>/dev/null)
[ -n "$SECRET_LOG" ] && echo "vibe-safe: possible sensitive data in log output -- scrub before production
$SECRET_LOG"

# 33. Security header regression
HELMET_REMOVED=$(echo "$STAGED_DIFF" | grep "^-" | grep -v "^---" | grep -E "helmet\(\)|require.*['\"]helmet['\"]|import.*['\"]helmet['\"]" 2>/dev/null)
[ -n "$HELMET_REMOVED" ] && echo "vibe-safe: helmet removed -- verify security headers are still set elsewhere
$HELMET_REMOVED"
INSECURE_HDR=$(echo "$ADDED" | grep -iE "content-security-policy.*unsafe-eval|content-security-policy.*unsafe-inline|x-frame-options.*ALLOW-FROM|strict-transport-security.*max-age=0" 2>/dev/null)
[ -n "$INSECURE_HDR" ] && echo "vibe-safe: insecure security header configuration
$INSECURE_HDR"

# 34. New API route without rate limiting
for f in $STAGED_FILES; do
  case "$f" in *.js|*.ts|*.jsx|*.tsx|*.py|*.rb) ;;
    *) continue ;;
  esac
  FILE_ADDED=$(git diff --cached -- "$f" 2>/dev/null | grep "^+" | grep -v "^+++")
  NEW_ROUTES=$(echo "$FILE_ADDED" | grep -E "app\.(get|post|put|delete|patch)\(|router\.(get|post|put|delete|patch)\(|@app\.route\(|@router\.(get|post|put|delete)\(" 2>/dev/null)
  if [ -n "$NEW_ROUTES" ]; then
    HAS_RATE=$(grep -E "rateLimit|rate_limit|throttle|slowapi|limiter|RateLimit|express-rate-limit|django-ratelimit" "$f" 2>/dev/null)
    [ -z "$HAS_RATE" ] && echo "vibe-safe: new route in $f has no rate limiting -- add before exposing to traffic"
  fi
done

# 35. Hardcoded credential objects (email + password literal in same file — seed/demo/fixture data)
# Vite/webpack bundle these into the public JS artifact, making them readable without auth.
CRED_OBJ=""
for f in $STAGED_FILES; do
  case "$f" in *.js|*.ts|*.jsx|*.tsx|*.mjs|*.cjs|*.py|*.rb|*.go) ;;
    *) continue ;;
  esac
  case "$f" in *.test.*|*.spec.*|*__tests__*|*_test.*|*fixture*|*seed*|*mock*) continue ;; esac
  FILE_ADDED=$(git diff --cached -- "$f" 2>/dev/null | grep "^+" | grep -v "^+++")
  HAS_EMAIL=$(echo "$FILE_ADDED" | grep -iE '\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b' 2>/dev/null)
  HAS_PASS=$(echo "$FILE_ADDED" | grep -iE 'password[[:space:]]*[:=]' 2>/dev/null | grep -v -iE '^\+[[:space:]]*(//|#|/\*)' 2>/dev/null)
  if [ -n "$HAS_EMAIL" ] && [ -n "$HAS_PASS" ]; then
    CRED_OBJ="${CRED_OBJ:+$CRED_OBJ
}  $f"
  fi
done
[ -n "$CRED_OBJ" ] && bail "STOP -- hardcoded credential object in source file (email + password literal):" "$CRED_OBJ" \
  "Bundlers (Vite/webpack) inline these into the public JS artifact — readable without auth. Move to env vars or a secrets manager."

# ──────────── Tier 1: more credential shapes ────────────

# 36. Connection strings with embedded credentials (postgres://user:pass@host)
CONN_CREDS=$(echo "$ADDED" | grep -iE "(postgres|postgresql|mysql|mongodb|mongodb\+srv|redis|amqp|amqps)://[a-zA-Z0-9_.\-]+:[^@'\"[:space:]/]{4,}@" 2>/dev/null)
[ -n "$CONN_CREDS" ] && bail "STOP -- connection string with embedded credentials:" "$CONN_CREDS" \
  "Move the password to an env var, build the URL at runtime."

# 37. PEM private key / certificate as string literal (file extension check already exists)
PEM_STR=$(echo "$ADDED" | grep -E "['\"\`]-----BEGIN [A-Z ]*(PRIVATE KEY|CERTIFICATE|RSA PRIVATE KEY|OPENSSH PRIVATE KEY)" 2>/dev/null)
[ -n "$PEM_STR" ] && bail "STOP -- PEM key/cert as inline string literal:" "$PEM_STR" \
  "Load from a secrets manager or file at runtime, not inline in source."

# 38. JWT structural pattern (header.payload.signature with eyJ prefix)
JWT_LIT=$(echo "$ADDED" | grep -E "eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_\-]{10,}" 2>/dev/null)
[ -n "$JWT_LIT" ] && bail "STOP -- JWT token literal in source:" "$JWT_LIT" \
  "JWTs in source are real, valid tokens. Rotate the signing key, revoke the token, move to env."

# 39. (covered by extended CRED_PATTERN above — ASIA/gho_/ghs_/ghr_/github_pat_/hf_/npm_/xox*/SG./whsec_)

# 40. Public-bundled env var with secret-ish name (NEXT_PUBLIC_*, VITE_*, REACT_APP_*)
PUB_SECRET=$(echo "$ADDED" | grep -E "(NEXT_PUBLIC_|VITE_|REACT_APP_|PUBLIC_|EXPO_PUBLIC_)[A-Z0-9_]*(SECRET|PRIVATE|TOKEN|API_KEY|APIKEY|PASSWORD|CREDENTIAL)" 2>/dev/null)
[ -n "$PUB_SECRET" ] && bail "STOP -- public-bundled env var name implies a secret:" "$PUB_SECRET" \
  "NEXT_PUBLIC_/VITE_/REACT_APP_/EXPO_PUBLIC_ vars are inlined into the public JS bundle. Rename or use a server-only var."

# ──────────── Tier 2: authz/authn mistakes ────────────

# 41. Permission decision from client-controlled input (handles dot AND bracket access)
CLIENT_AUTH=$(echo "$ADDED" | grep -iE "req\.(body|query|headers|params)\.(role|isAdmin|is_admin|permissions?|admin|owner|userId|user_id|sub|is_owner)|req\.(body|query|headers|params)\[['\"][^'\"]*(role|admin|user|owner|permission)" 2>/dev/null)
[ -n "$CLIENT_AUTH" ] && bail "STOP -- permission check from client-controlled input:" "$CLIENT_AUTH" \
  "req.body/query/headers/params are attacker-controlled. Read identity from req.user (set by auth middleware)."

# 42. Admin/internal route without visible auth middleware in same file
for f in $STAGED_FILES; do
  case "$f" in *.js|*.ts|*.jsx|*.tsx|*.py|*.rb) ;; *) continue ;; esac
  FILE_ADDED=$(git diff --cached -- "$f" 2>/dev/null | grep "^+" | grep -v "^+++")
  ADMIN_ROUTE=$(echo "$FILE_ADDED" | grep -E "(app|router)\.(get|post|put|delete|patch)\(['\"]/?(api/)?(admin|internal|_private|_admin|debug)/" 2>/dev/null)
  if [ -n "$ADMIN_ROUTE" ]; then
    HAS_AUTH=$(grep -iE "requireAuth|isAuthenticated|isAdmin|authenticate|authorize|@login_required|@admin_required|verifyToken|requireAdmin|requireRole|checkAuth|ensureAuth|withAuth" "$f" 2>/dev/null)
    [ -z "$HAS_AUTH" ] && echo "vibe-safe: admin/internal route in $f has no visible auth middleware -- verify auth is enforced upstream"
  fi
done

# 43. Webhook route without visible signature verification
for f in $STAGED_FILES; do
  case "$f" in *.js|*.ts|*.jsx|*.tsx|*.py|*.rb) ;; *) continue ;; esac
  FILE_ADDED=$(git diff --cached -- "$f" 2>/dev/null | grep "^+" | grep -v "^+++")
  WEBHOOK_ROUTE=$(echo "$FILE_ADDED" | grep -E "(app|router)\.(post|put)\(['\"]/?(api/)?(webhook|webhooks|hook|hooks)/" 2>/dev/null)
  if [ -n "$WEBHOOK_ROUTE" ]; then
    HAS_SIG=$(grep -iE "constructEvent|createHmac|verifySignature|stripe-signature|x-hub-signature|x-webhook-signature|x-signature|timingSafeEqual|verify_webhook" "$f" 2>/dev/null)
    [ -z "$HAS_SIG" ] && echo "vibe-safe: webhook route in $f has no visible signature verification -- accepts any payload"
  fi
done

# 44a. JWT sign without expiresIn (token never expires)
JWT_NO_EXP=$(echo "$ADDED" | grep -E "jwt\.sign\(|jwt\.encode\(" 2>/dev/null)
if [ -n "$JWT_NO_EXP" ]; then
  for f in $STAGED_FILES; do
    case "$f" in *.js|*.ts|*.jsx|*.tsx|*.py|*.rb) ;; *) continue ;; esac
    FILE_ADDED=$(git diff --cached -- "$f" 2>/dev/null | grep "^+" | grep -v "^+++")
    SIGN=$(echo "$FILE_ADDED" | grep -E "jwt\.sign\(|jwt\.encode\(" 2>/dev/null)
    if [ -n "$SIGN" ]; then
      HAS_EXP=$(echo "$FILE_ADDED" | grep -E "expiresIn|exp:|'exp'|\"exp\"" 2>/dev/null)
      [ -z "$HAS_EXP" ] && echo "vibe-safe: jwt.sign in $f without expiresIn/exp -- token never expires"
    fi
  done
fi

# 44b. JWT 'none' algorithm (signature bypass)
JWT_NONE=$(echo "$ADDED" | grep -iE "algorithm[s]?\s*:\s*['\"]none['\"]|algorithm[s]?\s*:\s*\[\s*['\"]none['\"]" 2>/dev/null)
[ -n "$JWT_NONE" ] && bail "STOP -- JWT 'none' algorithm accepts unsigned tokens:" "$JWT_NONE" \
  "Use HS256/RS256 with a real secret. 'none' is a signature bypass."

# 44c. JWT verify without algorithms whitelist
JWT_VERIFY=$(echo "$ADDED" | grep -E "jwt\.verify\(" 2>/dev/null)
if [ -n "$JWT_VERIFY" ]; then
  for f in $STAGED_FILES; do
    case "$f" in *.js|*.ts|*.jsx|*.tsx) ;; *) continue ;; esac
    FILE_ADDED=$(git diff --cached -- "$f" 2>/dev/null | grep "^+" | grep -v "^+++")
    VER=$(echo "$FILE_ADDED" | grep -E "jwt\.verify\(" 2>/dev/null)
    if [ -n "$VER" ]; then
      HAS_ALG=$(echo "$FILE_ADDED" | grep -E "algorithms\s*:" 2>/dev/null)
      [ -z "$HAS_ALG" ] && echo "vibe-safe: jwt.verify in $f without algorithms whitelist -- vulnerable to none-algorithm attack"
    fi
  done
fi

# ──────────── Tier 3: data exposure ────────────

# 45. Stack trace in HTTP response (information disclosure)
STACK_RES=$(echo "$ADDED" | grep -E "(res|response)\.(send|json|end|status\([0-9]+\)\.(send|json|end))\([^)]*\.(stack|trace)" 2>/dev/null)
[ -n "$STACK_RES" ] && bail "STOP -- stack trace returned in HTTP response:" "$STACK_RES" \
  "Leaks file paths, library versions, internal structure. Log server-side; return generic error to client."

# 46. localStorage / sessionStorage for auth tokens (XSS-readable)
LS_AUTH=$(echo "$ADDED" | grep -iE "(localStorage|sessionStorage)\.setItem\s*\(\s*['\"](token|jwt|access[_-]?token|auth[_-]?token|session|api[_-]?key|refresh[_-]?token|id[_-]?token|bearer)['\"]" 2>/dev/null)
[ -n "$LS_AUTH" ] && echo "vibe-safe: auth token stored in localStorage/sessionStorage -- readable by any XSS; prefer httpOnly cookie
$LS_AUTH"

# ──────────── Tier 4: server-side injection ────────────

# 47. SSRF — outbound HTTP with client-controlled URL
SSRF=$(echo "$ADDED" | grep -E "(fetch|axios\.(get|post|put|delete|patch|head)|got|http\.get|http\.request|urlopen|requests\.(get|post|put|delete))\s*\(\s*req\.(body|query|params|headers)" 2>/dev/null)
[ -n "$SSRF" ] && bail "STOP -- SSRF: outbound HTTP with client-controlled URL:" "$SSRF" \
  "Validate URL against allowlist. Attacker can hit 169.254.169.254 (cloud metadata), localhost, internal services."

# 48. Path traversal — file op with client-controlled path
PATH_TRAV=$(echo "$ADDED" | grep -E "(readFile|readFileSync|createReadStream|sendFile|writeFile|writeFileSync|unlink|open)\s*\([^)]*req\.(body|query|params|headers)" 2>/dev/null)
[ -n "$PATH_TRAV" ] && bail "STOP -- path traversal: filesystem op with client-controlled path:" "$PATH_TRAV" \
  "basename() or validate against allowlist. Attacker can read ../../etc/passwd or overwrite arbitrary files."

# 49. Open redirect — redirect to client-controlled URL
OPEN_REDIR=$(echo "$ADDED" | grep -E "(res|response)\.redirect\s*\(\s*([0-9]+\s*,\s*)?req\.(body|query|params|headers)" 2>/dev/null)
[ -n "$OPEN_REDIR" ] && bail "STOP -- open redirect: redirect target from client input:" "$OPEN_REDIR" \
  "Validate against allowlist. Used in phishing to leverage your domain's reputation."

# 50. Prototype pollution — merging client input into object
PROTO=$(echo "$ADDED" | grep -E "(Object\.assign|_\.merge|_\.defaultsDeep|_\.assignIn|extend|deepmerge)\s*\([^)]*,\s*req\.(body|query|params)" 2>/dev/null)
[ -n "$PROTO" ] && bail "STOP -- prototype pollution: merging client input into object:" "$PROTO" \
  "__proto__/constructor.prototype in req.body can pollute Object.prototype. Use a strict allowlist or safe-merge library."

# 51. NoSQL injection — $where or mass-assignment from req
NOSQL=$(echo "$ADDED" | grep -E "\\\$where\s*:|\.(find|findOne|update|updateOne|updateMany|deleteOne|deleteMany|count)\s*\(\s*req\.(body|query|params)" 2>/dev/null)
[ -n "$NOSQL" ] && bail "STOP -- NoSQL injection risk: \$where or mass-assignment from req:" "$NOSQL" \
  "\$where with user input or .find(req.body) allows operator injection ({\"\$ne\": null}). Cast and allowlist fields."

# ──────────── Tier 5: destructive ops & CI safety ────────────

# 52. UPDATE/DELETE without WHERE clause
DESTRUCTIVE_SQL=$(echo "$ADDED" | grep -iE "['\"\`](UPDATE\s+[a-zA-Z_][a-zA-Z0-9_.]*\s+SET\b|DELETE\s+FROM\s+[a-zA-Z_][a-zA-Z0-9_.]*)" 2>/dev/null | grep -ivE "WHERE|--.*WHERE" 2>/dev/null)
[ -n "$DESTRUCTIVE_SQL" ] && bail "STOP -- UPDATE/DELETE without WHERE clause:" "$DESTRUCTIVE_SQL" \
  "Affects every row in the table. Add WHERE or wrap in an explicit transaction with row limit."

# 53. Install-time scripts added to package.json (supply-chain attack vector)
if echo "$STAGED_FILES" | grep -q "package\.json"; then
  POSTINSTALL=$(echo "$ADDED" | grep -E '"(postinstall|preinstall|prepare|install)"[[:space:]]*:' 2>/dev/null)
  [ -n "$POSTINSTALL" ] && bail "PAUSE -- install-time script added to package.json:" "$POSTINSTALL" \
    "Runs on every npm install for every user. Verify the command before merging."
fi

# 54. GitHub Actions: pull_request_target without head SHA pinning (fork PR code-exec)
for wf in $WF_FILES; do
  if grep -q "pull_request_target" "$wf" 2>/dev/null; then
    HAS_PIN=$(grep -E "ref:\s*\\\$\{\{\s*github\.event\.pull_request\.head\.sha\s*\}\}" "$wf" 2>/dev/null)
    [ -z "$HAS_PIN" ] && bail "STOP -- pull_request_target workflow without ref pinning: $wf" "" \
      "Fork PRs can execute arbitrary code with repo secrets. Pin checkout to github.event.pull_request.head.sha."
  fi
done

# 55. continue-on-error / allow_failure on CI steps (silently disables checks)
CI_FILES=$(echo "$STAGED_FILES" | grep -E "\.github/workflows/.*\.ya?ml$|\.gitlab-ci\.yml$|bitbucket-pipelines\.yml$" 2>/dev/null)
for cf in $CI_FILES; do
  CF_ADDED=$(git diff --cached -- "$cf" 2>/dev/null | grep "^+" | grep -v "^+++")
  COE=$(echo "$CF_ADDED" | grep -iE "continue[-_]on[-_]error:\s*true|allow_failure:\s*true" 2>/dev/null)
  [ -n "$COE" ] && echo "vibe-safe: continue-on-error/allow_failure: true in $cf -- silently masks CI failures
$COE"
done

# ──────────── Tier 6: crypto pitfalls ────────────

# 56. Weak hash (MD5/SHA1) used in credential context
WEAK_HASH=$(echo "$ADDED" | grep -E "createHash\(['\"](md5|sha1)['\"]|hashlib\.(md5|sha1)\(|MessageDigest\.getInstance\(['\"](MD5|SHA-?1)['\"]" 2>/dev/null)
if [ -n "$WEAK_HASH" ]; then
  for f in $STAGED_FILES; do
    case "$f" in *.js|*.ts|*.jsx|*.tsx|*.py|*.rb|*.java|*.kt) ;; *) continue ;; esac
    FILE_ADDED=$(git diff --cached -- "$f" 2>/dev/null | grep "^+" | grep -v "^+++")
    HASH=$(echo "$FILE_ADDED" | grep -E "createHash\(['\"](md5|sha1)['\"]|hashlib\.(md5|sha1)\(|MessageDigest\.getInstance\(['\"](MD5|SHA-?1)['\"]" 2>/dev/null)
    if [ -n "$HASH" ]; then
      CTX=$(echo "$FILE_ADDED" | grep -iE "password|secret|token|auth|credential|hmac|sign" 2>/dev/null)
      [ -n "$CTX" ] && bail "STOP -- weak hash (MD5/SHA1) used in credential/auth context: $f" "$HASH" \
        "MD5/SHA1 are broken. Use bcrypt/argon2/scrypt for passwords; SHA-256+ for HMAC/integrity."
    fi
  done
fi

# 57. AES ECB mode (deterministic, leaks block patterns)
AES_ECB=$(echo "$ADDED" | grep -iE "createCipher(iv)?\s*\(\s*['\"]aes[-_]?[0-9]+[-_]?ecb|AES/ECB|Cipher\.getInstance\(['\"]AES['\"]?\s*\)" 2>/dev/null)
[ -n "$AES_ECB" ] && bail "STOP -- AES in ECB mode (or default Java AES = ECB):" "$AES_ECB" \
  "Use AES-GCM (authenticated) or AES-CBC with a random IV. ECB encrypts identical plaintext blocks identically."

# ──────────── Tier 7: migration integrity ────────────

# 58. Migration revision chain conflict (Alembic parallel-head / split-chain detection)
# When two migrations share the same down_revision, alembic upgrade head fails because
# there are multiple heads and it cannot determine which branch to follow.
MIG_STAGED=$(echo "$STAGED_FILES" | grep -E "migrations/.*\.py$" 2>/dev/null)
if [ -n "$MIG_STAGED" ]; then
  for mf in $MIG_STAGED; do
    # Read down_revision from the staged (index) version of the file
    DOWN_REV=$(git show ":$mf" 2>/dev/null | grep -E "^down_revision\s*=" | head -1 \
      | sed "s/.*=[[:space:]]*[\"']\([^\"']*\)[\"'].*/\1/")
    # Skip: empty, None (root migration), or tuple (merge migration — starts with '(')
    [ -z "$DOWN_REV" ] && continue
    case "$DOWN_REV" in None|none|null|"("*) continue ;; esac
    # Search the committed tree for another migration that uses the same down_revision
    CONFLICT=$(git grep -lP "^down_revision\s*=\s*[\"']${DOWN_REV}[\"']" HEAD 2>/dev/null | grep -v ":${mf}$")
    if [ -n "$CONFLICT" ]; then
      CONFLICT_FILE=$(echo "$CONFLICT" | sed 's/^HEAD://')
      bail "STOP -- migration revision conflict: two migrations share parent '$DOWN_REV'" \
        "  Your staged migration:  $mf
  Already on branch:     $CONFLICT_FILE" \
        "Update down_revision in $mf to the current migration HEAD (not '$DOWN_REV'). Run: alembic heads"
    fi
  done
fi

# ──────────── Tier 8: Python pitfalls ────────────

# 59. yaml.load() without SafeLoader — arbitrary Python code execution via crafted YAML
PY_STAGED=$(echo "$STAGED_FILES" | grep -E "\.py$" 2>/dev/null)
if [ -n "$PY_STAGED" ]; then
  YAML_UNSAFE=$(echo "$ADDED" | grep -E "\byaml\.load\s*\(" 2>/dev/null | grep -v -E "SafeLoader|BaseLoader|safe_load" 2>/dev/null)
  [ -n "$YAML_UNSAFE" ] && bail "STOP -- yaml.load() executes arbitrary Python from crafted YAML input:" "$YAML_UNSAFE" \
    "Use yaml.safe_load() instead. yaml.load() with a Loader that allows Python objects is RCE."
fi

# 60. pickle deserialization — arbitrary code execution, no conditions required
if [ -n "$PY_STAGED" ]; then
  PICKLE=$(echo "$ADDED" | grep -E "\bpickle\.(loads?|Unpickler)\s*\(" 2>/dev/null)
  [ -n "$PICKLE" ] && bail "STOP -- pickle deserialization: executing attacker-controlled bytecode:" "$PICKLE" \
    "Never unpickle data from untrusted or network sources. Use JSON, msgpack, or protobuf instead."
fi

# 61. Python bare except: — swallows KeyboardInterrupt, SystemExit, and all exceptions
if [ -n "$PY_STAGED" ]; then
  BARE_EXCEPT=$(echo "$ADDED" | grep -E "^\+[[:space:]]*except[[:space:]]*:" 2>/dev/null)
  [ -n "$BARE_EXCEPT" ] && bail "PAUSE -- bare except: added (swallows all exceptions incl. KeyboardInterrupt):" "$BARE_EXCEPT" \
    "Specify the exception type. Bare except: hides crashes and can mask security failures silently. Run: vibe-safe commit"
fi

# 62. Python exec() in non-test files
if [ -n "$PY_STAGED" ]; then
  PY_EXEC=$(echo "$ADDED" | grep -E "\bexec\s*\(" 2>/dev/null)
  if [ -n "$PY_EXEC" ]; then
    PY_NON_TEST=$(echo "$STAGED_FILES" | grep -E "\.py$" | grep -v -E "\.test\.|_test\.|/tests/|/test_" 2>/dev/null)
    [ -n "$PY_NON_TEST" ] && bail "PAUSE -- exec() in Python source file:" "$PY_EXEC" \
      "exec() runs arbitrary Python. If needed, verify input is from a trusted internal source only. Run: vibe-safe commit"
  fi
fi

# 63. Python random module in security-sensitive file (mirrors check 26 for JS)
PY_RND=$(git diff --cached -- '*.py' 2>/dev/null | grep "^+" | grep -v "^+++" | grep -E "\brandom\.(randint|randrange|choice|choices|shuffle|sample|random)\s*\(" 2>/dev/null)
if [ -n "$PY_RND" ]; then
  PY_SEC_FILES=$(echo "$STAGED_FILES" | grep -iE "auth|token|session|crypto|key|secret|password|otp|reset" 2>/dev/null | grep -E "\.py$" 2>/dev/null)
  if [ -n "$PY_SEC_FILES" ]; then
    bail "STOP -- random module in security-related Python file: use secrets.token_hex() or secrets.choice()
$PY_RND" "" ""
  fi
fi

# ──────────── Tier 10: weak defaults & misconfig ────────────

# 65. Default/placeholder secret assigned to a real secret name (LLM scaffold leakage)
WEAK_SECRET=$(echo "$ADDED" | grep -iE "(jwt[_-]?secret|secret[_-]?key|session[_-]?secret|signing[_-]?key|encryption[_-]?key|api[_-]?secret|app[_-]?secret)['\"]?\s*[:=]\s*['\"](secret|changeme|change[_-]?me|password|passwd|123456|12345678|your[_-]?secret|your[_-]?secret[_-]?here|placeholder|dev|test|default|example|todo|s3cr3t|mysecret|supersecret)['\"]" 2>/dev/null)
[ -n "$WEAK_SECRET" ] && bail "STOP -- default/placeholder value assigned to a secret:" "$WEAK_SECRET" \
  "This is a guessable secret. Generate a real one (openssl rand -hex 32) and load it from an env var."

# 66. Insecure cookie/session flags (httpOnly:false or secure:false)
COOKIE_INSECURE=$(echo "$ADDED" | grep -iE "(httpOnly|secure)\s*:\s*false" 2>/dev/null)
if [ -n "$COOKIE_INSECURE" ]; then
  COOKIE_CTX=$(echo "$ADDED" | grep -iE "cookie|session|res\.cookie|set-cookie|sameSite|maxAge|expires" 2>/dev/null)
  [ -n "$COOKIE_CTX" ] && echo "vibe-safe: insecure cookie flag (httpOnly:false / secure:false) -- token readable by JS or sent over HTTP
$COOKIE_INSECURE"
fi

# 67. World-writable permissions (chmod 777 / 0o777)
CHMOD_777=$(echo "$ADDED" | grep -E "chmod\s+-?R?\s*0?777|chmod\s*\([^,)]*,\s*0o?777|os\.chmod\([^,)]*,\s*0o?777|\.chmod\(\s*0o?777" 2>/dev/null)
[ -n "$CHMOD_777" ] && bail "PAUSE -- world-writable permissions (777):" "$CHMOD_777" \
  "Any user on the system can modify these files. Use the least-privilege mode (644 for files, 755 for dirs). Run: vibe-safe commit"

# 68. Go math/rand in security-sensitive file (mirrors checks 26 & 63)
GO_RND=$(git diff --cached -- '*.go' 2>/dev/null | grep "^+" | grep -v "^+++" | grep -E "\brand\.(Int|Intn|Int31|Int63|Float32|Float64|Perm|Shuffle)\s*\(" 2>/dev/null)
if [ -n "$GO_RND" ]; then
  GO_SEC_FILES=$(echo "$STAGED_FILES" | grep -iE "auth|token|session|crypto|key|secret|password|otp|reset" 2>/dev/null | grep -E "\.go$" 2>/dev/null)
  if [ -n "$GO_SEC_FILES" ]; then
    bail "STOP -- math/rand in security-related Go file: use crypto/rand instead
$GO_RND" "" ""
  fi
fi

echo "vibe-safe: all 70 checks passed -- clear"
